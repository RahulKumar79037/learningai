# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# Application URL
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"

# Node & Server
NODE_ENV="development"
PORT=3000

# MongoDB Atlas Connection
# If left empty, Learning Companion gracefully utilizes persistent local storage with full schema validation
# Set your MongoDB Atlas URI here to connect to cloud database:
MONGODB_URI=""

# Authentication & Security
JWT_SECRET="learning_companion_super_secret_jwt_key_2026_academic_secure"
JWT_EXPIRES_IN="7d"

# AI Model Configuration
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# File Uploads & Rate Limiting
MAX_FILE_SIZE=15728640
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

